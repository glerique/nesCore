# Auto detect text files and normalize line endings to LF
* text=auto

# PHP files
*.php text eol=lf diff=php

# Configuration files
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.env* text eol=lf
*.md text eol=lf

# Docker
Dockerfile text eol=lf
docker-compose.yaml text eol=lf
.dockerignore text eol=lf

# Binary files
*.gif binary
*.jpg binary
*.jpeg binary
*.png binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.gz binary
*.zip binary
